DATABASE_URL=postgresql+asyncpg://scanner:scanner@localhost:5432/scanner
ANTHROPIC_API_KEY=
LOG_LEVEL=INFO
# Risk gate Lớp 2 (USPTO) tra local index (bảng uspto_trademarks), không dùng live API
# -- xem docs/RISK_POLICY.md + src/scanner/pipeline/uspto_index.py. Set true chỉ sau
# khi đã tự nạp ĐỦ toàn bộ bulk data "Trademark Full Text XML Data" từ USPTO.
USPTO_INDEX_COVERAGE_COMPLETE=false
COLLECT_COUNTRY=US
# pinterest_suggest cần cookie phiên đăng nhập Pinterest thật (endpoint có CSRF/session
# check, gọi không kèm cookie trả 403). Lấy từ devtools trình duyệt đã đăng nhập:
# tab Network -> một request tới pinterest.com/resource/... -> copy header Cookie.
# Hết hạn định kỳ, cần refresh thủ công cho tới khi chuyển sang Playwright persistent
# context. Xem src/scanner/adapters/pinterest_suggest.py.
PINTEREST_COOKIE=
