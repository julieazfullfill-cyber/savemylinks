// Đặc tả giai đoạn 1 CGGroup — https://claude.ai/artifact/EtgCxATpUvTUtKCpJEghnW
// Quy ước bắt buộc (mục 01):
//  1. Tiền là BigInt, minor unit (VND = đồng, USD = cent). Không Float/Double.
//  2. Mỗi số tiền có amount + currency + amountVnd (quy đổi theo tỷ giá ngày giao dịch, lưu cứng).
//  3. Không xoá bản ghi tài chính: voidedAt/voidedBy, sửa bằng bút toán ngược.
//  4. Giờ lưu UTC; ngày nghiệp vụ dùng @db.Date riêng.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  KE_TOAN
  QUAN_LY
  NHAN_VIEN
}

enum Currency {
  VND
  USD
}

enum AccountKind {
  BANK
  EWALLET
  PLATFORM
  CASH
}

enum Direction {
  IN
  OUT
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  PAID
  REJECTED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COGS
  EXPENSE
  OTHER
}

// ───────────────────────── nền tảng ─────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         Role     @default(NHAN_VIEN)
  active       Boolean  @default(true)
  /// Bổ sung so với đặc tả: đăng nhập email + mật khẩu (bcrypt).
  passwordHash String?
  createdAt    DateTime @default(now())
}

/// Ghi mọi thay đổi. Không có API xoá — kể cả ADMIN.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String
  tableName String
  recordId  String
  action    String // CREATE | UPDATE | VOID
  before    Json?
  after     Json?
  at        DateTime @default(now())

  @@index([tableName, recordId])
  @@index([at])
}

/// Tỷ giá theo ngày. Mọi quy đổi tra bảng này, không hardcode.
model FxRate {
  id    Int      @id @default(autoincrement())
  date  DateTime @db.Date
  base  Currency
  quote Currency
  rate  Decimal  @db.Decimal(18, 6)

  @@unique([date, base, quote])
}

model Attachment {
  id         String   @id @default(cuid())
  url        String
  filename   String
  tableName  String
  recordId   String
  uploadedBy String
  uploadedAt DateTime @default(now())

  @@index([tableName, recordId])
}

// ───────────────────────── danh mục ─────────────────────────

model LegalEntity {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  kind          String // LLC | HO_KINH_DOANH | CONG_TY_TNHH
  country       String
  taxCode       String?
  renewalDate   DateTime? @db.Date
  annualCostVnd BigInt?
  active        Boolean   @default(true)

  cashAccounts CashAccount[]
  filings      EntityFiling[]
}

/// Hệ thống tài khoản nội bộ — 35 tài khoản tự đặt.
model Account {
  code  String        @id // "101", "601"…
  name  String
  type  AccountType
  lines JournalLine[]
}

model ExpenseCategory {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  accountCode String // trỏ về Account.code
  recurring   Boolean @default(true) // định kỳ hay một lần
  /// Bổ sung: ngày trong tháng khoản định kỳ đến hạn — để dự báo rơi đúng tuần.
  dueDay      Int?
  /// Bổ sung: ngân sách/tháng (VND) — số dự kiến cho dự báo + cảnh báo chi vượt ngân sách.
  budgetVnd   BigInt?
  active      Boolean @default(true)

  expenses Expense[]
  txns     CashTxn[]
}

model Supplier {
  id         String  @id @default(cuid())
  code       String  @unique
  name       String
  service    String? // FULFILL | TOOL | DICH_VU…
  prepaid    Boolean @default(true) // trả trước hay công nợ
  creditDays Int     @default(0)
  active     Boolean @default(true)

  bills        SupplierBill[]
  fulfillments FulfillmentOrder[]
  prices       SupplierPrice[]
}

/// Shop — GĐ1 chỉ cần danh mục, nghiệp vụ đơn hàng để GĐ3.
model Shop {
  id              String       @id @default(cuid())
  code            String       @unique
  name            String
  channel         String // AMAZON | ETSY | WALMART | TIKTOK | WEBSITE (CHECK shop_channel)
  entityId        String?
  ownerId         String? // User phụ trách
  /// ACTIVE | UNDER_REVIEW | SUSPENDED | DEACTIVATED | CLOSED (CHECK shop_status, GĐ3)
  status          String       @default("ACTIVE")
  openedAt        DateTime?    @db.Date
  /// GĐ3: tài khoản nhận tiền của shop (màn 16, 17)
  payoutAccountId String?
  payoutAccount   CashAccount? @relation("ShopPayoutAccount", fields: [payoutAccountId], references: [id])

  orders       Order[]
  healthEvents ShopHealthEvent[]
  payouts      Payout[]
}

// ───────────────────────── tiền & sổ ─────────────────────────

/// Nhóm tài khoản tiền: Payoneer, Airwallex, PingPong, Ngân hàng… — tạo ở màn 8.
/// glAccount là tài khoản kế toán mặc định cho các tài khoản tiền trong nhóm.
model CashProvider {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  kind      AccountKind
  glAccount String
  active    Boolean     @default(true)

  accounts CashAccount[]
}

model CashAccount {
  id         String       @id @default(cuid())
  code       String       @unique
  name       String
  /// Bổ sung: tài khoản tiền thuộc một nhóm (Payoneer, Airwallex…), nhận diện bằng email đăng nhập.
  providerId String
  provider   CashProvider @relation(fields: [providerId], references: [id])
  email      String?
  kind       AccountKind
  currency   Currency
  entityId   String?
  entity     LegalEntity? @relation(fields: [entityId], references: [id])
  glAccount  String // Account.code tương ứng — mặc định theo nhóm
  active     Boolean      @default(true)

  txns     CashTxn[]
  balances AccountBalance[]
  payouts  Payout[]
  shops    Shop[]           @relation("ShopPayoutAccount")

  @@unique([providerId, email])
}

/// Số dư chốt cuối ngày. 'reserved' là phần sàn đang giam.
model AccountBalance {
  id        String      @id @default(cuid())
  accountId String
  account   CashAccount @relation(fields: [accountId], references: [id])
  date      DateTime    @db.Date
  available BigInt
  reserved  BigInt      @default(0)
  releaseOn DateTime?   @db.Date // ngày reserve dự kiến về
  note      String?

  @@unique([accountId, date])
}

/// Giao dịch tiền thật. Nguồn duy nhất của số dư.
model CashTxn {
  id          String           @id @default(cuid())
  date        DateTime         @db.Date
  accountId   String
  account     CashAccount      @relation(fields: [accountId], references: [id])
  direction   Direction
  amount      BigInt // nguyên tệ, minor unit
  currency    Currency
  fxRate      Decimal          @db.Decimal(18, 6)
  amountVnd   BigInt // lưu cứng tại thời điểm ghi
  categoryId  String?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  supplierId  String?
  shopId      String?
  description String
  journalId   String?          @unique
  journal     JournalEntry?    @relation(fields: [journalId], references: [id])
  createdBy   String
  createdAt   DateTime         @default(now())
  voidedAt    DateTime?
  voidedBy    String?

  @@index([date])
  @@index([accountId, date])
}

/// Khoản chi có quy trình duyệt. Duyệt xong + chi tiền → sinh CashTxn.
model Expense {
  id             String          @id @default(cuid())
  date           DateTime        @db.Date
  categoryId     String
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  supplierId     String?
  amount         BigInt
  currency       Currency
  amountVnd      BigInt
  description    String
  status         ExpenseStatus   @default(DRAFT)
  requestedBy    String
  approvedBy     String?
  approvedAt     DateTime?
  cashTxnId      String?         @unique
  /// Bổ sung: bút toán ghi nhận chi phí khi duyệt (Nợ TK hạng mục / Có 201).
  journalId      String?         @unique
  rejectedReason String?
  createdAt      DateTime        @default(now())

  @@index([status, date])
}

/// Hoá đơn nhà cung cấp — công nợ phải trả, đẩy vào dự báo.
model SupplierBill {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  billNo      String?
  issueDate   DateTime @db.Date
  dueDate     DateTime @db.Date
  amount      BigInt
  currency    Currency
  amountVnd   BigInt
  paidVnd     BigInt   @default(0)
  status      String   @default("OPEN") // OPEN | PARTIAL | PAID
  /// Bổ sung: TK chi phí ghi Nợ khi nhận hoá đơn (mặc định 501 fulfillment), Có 201.
  accountCode String   @default("501")
  description String?
  /// Bổ sung: bút toán ghi nhận công nợ khi nhận hoá đơn.
  journalId   String?  @unique
  createdBy   String?
  createdAt   DateTime @default(now())

  payments BillPayment[]

  @@index([dueDate, status])
}

/// Bổ sung: mỗi lần trả tiền cho một hoá đơn — nối hoá đơn với giao dịch tiền (Nợ 201 / Có TK tiền).
model BillPayment {
  id        String       @id @default(cuid())
  billId    String
  bill      SupplierBill @relation(fields: [billId], references: [id])
  cashTxnId String       @unique
  amountVnd BigInt
  createdAt DateTime     @default(now())

  @@index([billId])
}

/// Bổ sung (đặc tả mục 06, điểm 3): lưu dự báo mỗi tuần để đo độ lệch sau này.
model ForecastSnapshot {
  id        String   @id @default(cuid())
  weekStart DateTime @db.Date
  scenario  Json
  rows      Json
  createdBy String
  createdAt DateTime @default(now())

  @@index([weekStart])
}

/// Bút toán. Ràng buộc tổng nợ = tổng có kiểm ở tầng ứng dụng + trigger SQL.
model JournalEntry {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  memo       String
  source     String // CASH_TXN | EXPENSE | OPENING | ADJUST
  createdBy  String
  createdAt  DateTime @default(now())
  reversalOf String?

  lines   JournalLine[]
  cashTxn CashTxn?

  @@index([date])
}

model JournalLine {
  id          String       @id @default(cuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountCode String
  account     Account      @relation(fields: [accountCode], references: [code])
  debitVnd    BigInt       @default(0)
  creditVnd   BigInt       @default(0)
  shopId      String?
  entityId    String?

  @@index([accountCode])
}

/// Khoản dự kiến thu/chi do người dùng thêm tay (thuế, khoản bất thường).
model ForecastItem {
  id         String    @id @default(cuid())
  expectedOn DateTime  @db.Date
  direction  Direction
  amountVnd  BigInt
  label      String
  confidence Int       @default(100) // % chắc chắn
  recurring  String? // MONTHLY | WEEKLY | null

  @@index([expectedOn])
}

/// Dữ liệu T4–T10 đọc từ Excel. Chỉ đọc, không vào sổ kép.
model LegacyPnl {
  id         Int     @id @default(autoincrement())
  team       String
  month      Int
  year       Int
  revenueUsd Decimal @db.Decimal(14, 2)
  expenseUsd Decimal @db.Decimal(14, 2)
  profitUsd  Decimal @db.Decimal(14, 2)

  @@unique([team, year, month])
}

// ===================================================================
// GIAI ĐOẠN 2 — Nhân sự, chấm công, tiền lương
// Đặc tả: https://claude.ai/artifact/7sjsZZxEwv4q2PGCoGbo1i
// Chỉ thêm mới, không sửa model nào của giai đoạn 1.
// ===================================================================

enum WorkMode {
  OFFICE
  ONLINE
  HYBRID
}

enum EmployeeStatus {
  PROBATION
  OFFICIAL
  RESIGNED
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CLOSED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Department {
  id       String       @id @default(cuid())
  code     String       @unique
  name     String
  parentId String?
  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children Department[] @relation("DeptTree")
  active   Boolean      @default(true)

  employees Employee[]
}

model Position {
  id   String @id @default(cuid())
  code String @unique
  name String

  employees Employee[]
}

model Employee {
  id           String         @id @default(cuid())
  code         String         @unique // NV01, NV02…
  fullName     String
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id])
  positionId   String?
  position     Position?      @relation(fields: [positionId], references: [id])
  managerId    String?
  manager      Employee?      @relation("Reports", fields: [managerId], references: [id])
  reports      Employee[]     @relation("Reports")
  userId       String?        @unique // nối sang User của GĐ1
  status       EmployeeStatus @default(PROBATION)
  /// ONL trong bảng chấm công cũ là thuộc tính của NGƯỜI, không phải của ngày
  workMode     WorkMode       @default(OFFICE)
  joinedAt     DateTime       @db.Date
  leftAt       DateTime?      @db.Date
  bankAccount  String?
  bankName     String?

  contracts     EmploymentContract[]
  attendance    AttendanceDay[]
  payrollLines  PayrollLine[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  kpiTargets    KpiTarget[]
  kpiResults    KpiResult[]

  @@index([status])
}

/// Lương thuộc về HỢP ĐỒNG có hiệu lực theo khoảng ngày.
/// Tăng lương = tạo bản ghi mới, KHÔNG sửa đè (trigger chặn) — nhờ vậy tra được
/// lương của bất kỳ tháng nào trong quá khứ.
model EmploymentContract {
  id                 String    @id @default(cuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id])
  effectiveFrom      DateTime  @db.Date
  effectiveTo        DateTime? @db.Date
  baseSalaryVnd      BigInt // lương cứng
  allowanceVnd       BigInt    @default(0) // phụ cấp chung
  mealVnd            BigInt    @default(0) // phụ cấp ăn — miễn thuế đến một mức
  transportVnd       BigInt    @default(0) // vé tháng xe máy
  dutyVnd            BigInt    @default(0) // phụ cấp trách nhiệm
  /// Mức lương đóng BHXH — thường thấp hơn lương thực nhận
  insuranceSalaryVnd BigInt    @default(0)
  dependents         Int       @default(0) // số người phụ thuộc, giảm trừ TNCN
  note               String?

  @@index([employeeId, effectiveFrom])
}

/// Lệch đặc tả: `date` dùng @db.Date thay vì String, theo quy ước 4 của GĐ1.
model Holiday {
  date DateTime @id @db.Date
  name String
  paid Boolean  @default(true)
}

/// Một dòng = một người một ngày. 1 = đủ, 0.5 = nửa ngày, 0 = nghỉ.
model AttendanceDay {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime @db.Date
  value      Decimal  @db.Decimal(3, 2) // 1.00 | 0.50 | 0.00
  reason     String?
  approvedBy String?
  source     String   @default("MANUAL") // MANUAL | IMPORT

  @@unique([employeeId, date])
  @@index([date])
}

model LeaveType {
  id          String   @id @default(cuid())
  code        String   @unique // PHEP_NAM, KHONG_LUONG, OM…
  name        String
  paid        Boolean  @default(true)
  daysPerYear Decimal? @db.Decimal(5, 2)

  balances LeaveBalance[]
  requests LeaveRequest[]
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  entitled    Decimal   @db.Decimal(5, 2)
  used        Decimal   @default(0) @db.Decimal(5, 2)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])
  fromDate    DateTime    @db.Date
  toDate      DateTime    @db.Date
  days        Decimal     @db.Decimal(5, 2)
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedBy  String?

  @@index([employeeId, fromDate])
}

/// Kỳ lương. Quy trình: DRAFT -> CALCULATED -> APPROVED -> PAID -> CLOSED.
/// Từ APPROVED trở đi các dòng lương bất biến (trigger); điều chỉnh đi qua kỳ kế tiếp.
model PayrollPeriod {
  id               String        @id @default(cuid())
  year             Int
  month            Int
  standardDays     Decimal       @db.Decimal(5, 2) // ngày công chuẩn của tháng
  status           PayrollStatus @default(DRAFT)
  /// Lợi nhuận công ty tháng đó — dùng làm cổng chặn thưởng
  companyProfitVnd BigInt?
  calculatedAt     DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  journalId        String?       @unique
  closedAt         DateTime?
  /// Bổ sung: phê duyệt vượt cấp chi thưởng bị giữ trong tháng lỗ (người duyệt, lúc nào).
  bonusOverrideBy  String?
  bonusOverrideAt  DateTime?
  paidAt           DateTime?
  /// Bổ sung: giao dịch chi lương (Nợ 202) — huỷ giao dịch này thì kỳ quay về APPROVED.
  paidCashTxnId    String?       @unique

  adjustments PayrollAdjustment[]

  lines PayrollLine[]

  @@unique([year, month])
}

/// Bổ sung: lương hiệu quả và khấu trừ nhập tay cho từng người trước khi tính kỳ (màn 13).
model PayrollAdjustment {
  id         String        @id @default(cuid())
  periodId   String
  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId String
  perfPayVnd BigInt        @default(0)
  penaltyVnd BigInt        @default(0)
  note       String?

  @@unique([periodId, employeeId])
}

/// Một dòng = một người một kỳ. TỔNG KỲ LƯƠNG LUÔN LÀ SUM(payrollLine),
/// không có ô nào để gõ tổng — đây là chỗ sinh ra lệch 11,1 triệu tháng 8.
model PayrollLine {
  id         String        @id @default(cuid())
  periodId   String
  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])

  workedDays Decimal @db.Decimal(5, 2)
  leaveDays  Decimal @default(0) @db.Decimal(5, 2)

  baseSalaryVnd   BigInt // lương cứng theo hợp đồng
  proratedVnd     BigInt // lương theo ngày công thực tế
  allowanceVnd    BigInt @default(0)
  salesBonusVnd   BigInt @default(0) // thưởng doanh số ĐÃ qua cổng duyệt
  perfPayVnd      BigInt @default(0) // lương hiệu quả
  bonusHeldVnd    BigInt @default(0) // phần bị giữ lại vì tháng lỗ
  insuranceEmpVnd BigInt @default(0) // NLĐ chịu
  insuranceCoVnd  BigInt @default(0) // công ty chịu — chi phí, không trừ lương
  pitVnd          BigInt @default(0)
  penaltyVnd      BigInt @default(0)
  netVnd          BigInt

  note String?

  @@unique([periodId, employeeId])
}

/// KPI giao cho từng người theo tháng.
model KpiTarget {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  year       Int
  month      Int
  targetUsd  Decimal  @db.Decimal(12, 2)
  shopIds    String[] // shop người này phụ trách

  @@unique([employeeId, year, month])
}

/// Kết quả KPI. profit = tiền VỀ THẬT - giá vốn FF - chi phí chung phân bổ.
model KpiResult {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  year            Int
  month           Int
  cashReceivedUsd Decimal  @db.Decimal(12, 2)
  ffCostUsd       Decimal  @db.Decimal(12, 2)
  overheadUsd     Decimal  @default(0) @db.Decimal(12, 2)
  profitUsd       Decimal  @db.Decimal(12, 2)
  targetUsd       Decimal  @db.Decimal(12, 2)
  achievedPct     Decimal  @db.Decimal(8, 4)
  bonusVnd        BigInt   @default(0)

  @@unique([employeeId, year, month])
}

/// Bậc thưởng theo % đạt KPI. Ví dụ 100-120% -> 2% profit vượt.
model BonusRule {
  id      String   @id @default(cuid())
  name    String
  fromPct Decimal  @db.Decimal(6, 2)
  toPct   Decimal? @db.Decimal(6, 2)
  ratePct Decimal  @db.Decimal(6, 2) // % trên phần profit vượt target
  capVnd  BigInt?
  active  Boolean  @default(true)
}

/// Tham số BHXH và TNCN — để trong DB để đổi được khi chính sách thay đổi, không hardcode.
model PayrollSetting {
  key       String   @id
  valueJson Json
  note      String?
  updatedAt DateTime @updatedAt
}

// ===================================================================
// GIAI ĐOẠN 3 — Shop, nhà cung cấp, đơn hàng
// Đặc tả: https://claude.ai/artifact/D2kfxhyzcpapDHUB3G1JEx
// Đơn hàng là dữ liệu PHÂN TÍCH (biên lãi, đối soát) — không ghi sổ cái; doanh thu vào sổ
// khi tiền về (payout → "Thu từ shop"), tránh ghi doanh thu hai lần. Sổ kép đầy đủ: GĐ4.
// ===================================================================

enum FulfillStatus {
  PENDING
  SUBMITTED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  FAILED
}

enum OrderStatus {
  NEW
  PROCESSING
  FULFILLED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Design {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  niche     String?
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id       String  @id @default(cuid())
  sku      String  @unique
  name     String
  designId String?
  design   Design? @relation(fields: [designId], references: [id])
  type     String? // TSHIRT | HOODIE | ORNAMENT | MUG…
  active   Boolean @default(true)

  variants Variant[]
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  sku       String  @unique
  size      String?
  color     String?

  items OrderItem[]
}

/// Doanh thu GHI NHẬN theo ngày đặt; tiền về theo ngày payout — hai mốc tách bạch.
model Order {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id])
  externalId String // mã đơn trên sàn
  orderedAt  DateTime @db.Date
  country    String?
  currency   Currency @default(USD)

  grossUsd           Decimal @db.Decimal(12, 2)
  discountUsd        Decimal @default(0) @db.Decimal(12, 2)
  shippingChargedUsd Decimal @default(0) @db.Decimal(12, 2)
  platformFeeUsd     Decimal @default(0) @db.Decimal(12, 2)
  taxUsd             Decimal @default(0) @db.Decimal(12, 2)
  netUsd             Decimal @db.Decimal(12, 2)

  status        OrderStatus  @default(NEW)
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  items        OrderItem[]
  cost         OrderCost?
  fulfillments FulfillmentOrder[]
  refunds      Refund[]
  payoutLines  PayoutLine[]

  @@unique([shopId, externalId])
  @@index([orderedAt])
  @@index([shopId, orderedAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      Variant? @relation(fields: [variantId], references: [id])
  sku          String
  qty          Int      @default(1)
  unitPriceUsd Decimal  @db.Decimal(12, 2)
}

/// Giá vốn từng đơn → biên lãi từng đơn. Tính lại bằng recomputeOrderCosts().
model OrderCost {
  id            String  @id @default(cuid())
  orderId       String  @unique
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ffCostUsd     Decimal @default(0) @db.Decimal(12, 2)
  shipCostUsd   Decimal @default(0) @db.Decimal(12, 2)
  designCostUsd Decimal @default(0) @db.Decimal(12, 2)
  adsCostUsd    Decimal @default(0) @db.Decimal(12, 2)
  overheadUsd   Decimal @default(0) @db.Decimal(12, 2)
}

model Refund {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  refundedAt DateTime @db.Date
  amountUsd  Decimal  @db.Decimal(12, 2)
  reason     String?
}

model FulfillmentOrder {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  externalId    String?
  /// Bổ sung: SKU để tra bảng giá NCC (đơn nhiều mặt hàng → một đơn fulfill mỗi SKU)
  sku           String?
  submittedAt   DateTime?     @db.Date
  status        FulfillStatus @default(PENDING)
  costUsd       Decimal       @default(0) @db.Decimal(12, 2)
  shipUsd       Decimal       @default(0) @db.Decimal(12, 2)
  /// Giá theo bảng giá tại thời điểm đặt — để so với giá thực trả
  listedCostUsd Decimal?      @db.Decimal(12, 2)
  trackingNo    String?

  @@index([supplierId, submittedAt])
  @@index([status])
}

/// Bảng giá NCC theo thời kỳ (giá mới = bản ghi mới, bản cũ tự đóng — như hợp đồng lương).
model SupplierPrice {
  id            String    @id @default(cuid())
  supplierId    String
  supplier      Supplier  @relation(fields: [supplierId], references: [id])
  sku           String
  priceUsd      Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  @@index([supplierId, sku, effectiveFrom])
}

/// Một lần sàn trả tiền. Bổ sung shopId: tiền về ghi "Thu từ shop" vào doanh thu của kênh shop.
model Payout {
  id         String      @id @default(cuid())
  accountId  String
  account    CashAccount @relation(fields: [accountId], references: [id])
  shopId     String?
  shop       Shop?       @relation(fields: [shopId], references: [id])
  channel    String
  periodFrom DateTime    @db.Date
  periodTo   DateTime    @db.Date
  grossUsd   Decimal     @db.Decimal(12, 2)
  feeUsd     Decimal     @default(0) @db.Decimal(12, 2)
  netUsd     Decimal     @db.Decimal(12, 2)
  arrivedAt  DateTime?   @db.Date
  cashTxnId  String?     @unique
  reconciled Boolean     @default(false)
  createdAt  DateTime    @default(now())

  lines PayoutLine[]

  @@index([arrivedAt])
}

model PayoutLine {
  id              String  @id @default(cuid())
  payoutId        String
  payout          Payout  @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?  @relation(fields: [orderId], references: [id])
  /// Bổ sung: mã đơn trên sàn như trong file payout (giữ lại cả khi không khớp đơn nào)
  externalOrderId String?
  amountUsd       Decimal @db.Decimal(12, 2)
  kind            String  @default("ORDER") // ORDER | FEE | REFUND | ADJUST
}

/// Lịch sử đổi trạng thái shop — tần suất bị treo theo kênh và người phụ trách.
model ShopHealthEvent {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id])
  at         DateTime @db.Date
  fromStatus String
  toStatus   String
  note       String?
  createdBy  String?

  @@index([shopId, at])
}

/// Hạn gia hạn pháp nhân, hạn nộp hồ sơ. Khoản OPEN có số tiền đi vào dự báo 13 tuần.
model EntityFiling {
  id          String      @id @default(cuid())
  entityId    String
  entity      LegalEntity @relation(fields: [entityId], references: [id])
  kind        String // ANNUAL_REPORT | RENEWAL | TAX_5472 | TAX_HKD
  dueDate     DateTime    @db.Date
  amountVnd   BigInt?
  status      String      @default("OPEN") // OPEN | DONE | LATE
  completedAt DateTime?   @db.Date

  @@index([dueDate, status])
}

model ImportBatch {
  id         String   @id @default(cuid())
  channel    String
  filename   String
  rowCount   Int
  okCount    Int      @default(0)
  errorCount Int      @default(0)
  importedBy String
  importedAt DateTime @default(now())
  note       String?

  orders Order[]
}
