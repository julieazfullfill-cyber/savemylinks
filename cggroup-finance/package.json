{
  "name": "cggroup-finance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:unit": "dotenv -v VITEST_UNIT=1 -- vitest run --exclude \"tests/**/*.db.test.ts\"",
    "test": "dotenv -e .env.test -- vitest run",
    "payroll:selftest": "tsx scripts/payroll-selftest.ts",
    "phase3:selftest": "tsx scripts/phase3-selftest.ts",
    "phase4:selftest": "tsx scripts/phase4-selftest.ts",
    "alerts:daily": "tsx scripts/daily-alerts.ts",
    "import:seed": "tsx scripts/import-seed-data.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
